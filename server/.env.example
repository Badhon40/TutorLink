# Database Connection URL (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/tutorLink?schema=public"

# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# JWT Authentication (Minimum 64 characters secret)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-token-key-with-minimum-64-characters-length"
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# SSLCOMMERZ Payment Gateway Configuration (Bangladesh)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Public Backend URL for SSLCommerz callbacks / webhooks (or ngrok/tunnel URL in dev)
API_BASE_URL=http://localhost:5000

# Telegram Bot Notifications (Optional in dev)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_tutorlink_bot

# Live Class WebRTC / Provider Configuration
LIVE_CLASS_SECRET=your-live-class-signing-secret
